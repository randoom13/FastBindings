<Project Sdk="Microsoft.NET.Sdk">
  <!-- Packs FastBindings.WPF from FastBindings.WPF.nuspec: the two WPF builds, built first (scripts/pack.sh builds them in Release).
       The project itself has no code; the version comes from -p:Version (NuspecProperties). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>FastBindings.WPF.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
    <NuspecProperties>version=$(Version)</NuspecProperties>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
</Project>
