<?xml version="1.0" encoding="utf-8"?>
<!-- FastBindings.WPF: both WPF builds in one package, FastBinding.Net5 for .NET 5+ and FastBinding.Net4.5 for .NET Framework.
     Built after both projects (scripts/pack.sh); the version comes from the build ($version$). Before this file the package
     was the build output of this project itself, so 1.1.3 held only an empty FastBinding.Package.dll. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FastBindings.WPF</id>
    <version>$version$</version>
    <title>Advanced Fast Binding WPF</title>
    <authors>Chronos</authors>
    <owners>O.Kl</owners>
    <description>Advanced Bindings</description>
    <tags>#Binding #WPF #AsyncBinding</tags>
    <license type="file">LICENSE.txt</license>
    <readme>docs\README.md</readme>
    <repository type="git" url="https://github.com/randoom13/FastBindings.git" />
    <dependencies>
      <group targetFramework=".NETFramework4.5">
        <dependency id="System.ValueTuple" version="4.5.0" />
      </group>
      <group targetFramework="net5.0-windows7.0" />
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net5.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
    </frameworkReferences>
  </metadata>
  <files>
    <file src="..\FastBinding.Net5\bin\Release\net5.0-windows\FastBinding.Net5.dll" target="lib\net5.0-windows7.0\" />
    <file src="..\FastBinding.Net4.5\bin\Release\net45\FastBinding.Net4.5.dll" target="lib\net45\" />
    <file src="..\README.md" target="docs\" />
    <file src="..\FastBinding.Net5\LICENSE.txt" target="" />
  </files>
</package>
