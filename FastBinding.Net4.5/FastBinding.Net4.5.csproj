<Project Sdk="Microsoft.NET.Sdk">
  <!-- FastBindings for WPF on .NET Framework 4.5 (package FastBindings.WPF_45, FastBindings.WPF_45.nuspec). The same code as
       FastBinding.Net5, in files of its own; an SDK-style project so that dotnet build builds it on any machine. -->
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>FastBindings</RootNamespace>
    <AssemblyName>FastBinding.Net4.5</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- packed from FastBindings.WPF_45.nuspec; the version comes from -p:Version (scripts/pack.sh) -->
    <NuspecFile>FastBindings.WPF_45.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NuspecProperties>version=$(Version)</NuspecProperties>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="FastBindings.WPF_45.nuspec" />
  </ItemGroup>
</Project>
