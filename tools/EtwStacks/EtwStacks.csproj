<Project Sdk="Microsoft.NET.Sdk">
  <!-- A CPU profile of a .NET Framework process through ETW (EventPipe, dotnet-trace's source, exists only on .NET Core), written as
       speedscope so scripts/profile-steps.py reads it like dotnet-trace's. Windows only, run as administrator (a kernel session). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.13" />
  </ItemGroup>
</Project>
