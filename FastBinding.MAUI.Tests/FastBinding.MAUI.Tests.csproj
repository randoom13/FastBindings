<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FastBindings.Tests</RootNamespace>
    <!-- XAML compiled (XamlC) in Debug too, as an app's Release build: MAUI's runtime XAML parser is not safe on many threads
         at once, and the tests run in parallel -->
    <_MauiForceXamlCForDebug>True</_MauiForceXamlCForDebug>
    <MauiVersion Condition="'$(MauiVersion)' == ''">8.0.100</MauiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views\*.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastBinding.MAUI\FastBinding.MAUI.csproj" />
  </ItemGroup>

</Project>
