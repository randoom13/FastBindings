<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaBench" xmlns:f="using:FastBindings" x:Class="AvaloniaBench.FastNullCheck" x:DataType="vm:CheckVm">
  <StackPanel>
    <ItemsControl ItemsSource="{f:CommonBinding List}" />
  </StackPanel>
</UserControl>
