<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaBench" xmlns:f="using:FastBindings" x:Class="AvaloniaBench.FastDotted" x:DataType="vm:Vm">
  <StackPanel>
    <TextBlock Text="{f:CommonBinding Child.A}" Width="{f:CommonBinding Child.W}" IsVisible="{f:CommonBinding Child.V}" />
  </StackPanel>
</UserControl>
