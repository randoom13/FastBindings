<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaBench"  x:Class="AvaloniaBench.ReflectionFlat">
  <StackPanel>
    <TextBlock Text="{ReflectionBinding A}" Width="{ReflectionBinding W}" IsVisible="{ReflectionBinding V}" />
  </StackPanel>
</UserControl>
