<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaBench" xmlns:f="using:FastBindings" x:Class="AvaloniaBench.FastAccessorFlat" x:DataType="vm:AccVm">
  <StackPanel>
    <TextBlock Text="{f:FastBinding A}" Width="{f:FastBinding W}" IsVisible="{f:FastBinding V}" />
  </StackPanel>
</UserControl>
