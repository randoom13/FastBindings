<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaBench"  x:Class="AvaloniaBench.ReflectionDotted">
  <StackPanel>
    <TextBlock Text="{ReflectionBinding Child.A}" Width="{ReflectionBinding Child.W}" IsVisible="{ReflectionBinding Child.V}" />
  </StackPanel>
</UserControl>
