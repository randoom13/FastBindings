<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaBench"  x:Class="AvaloniaBench.CompiledFlat" x:DataType="vm:Vm">
  <StackPanel>
    <TextBlock Text="{Binding A}" Width="{Binding W}" IsVisible="{Binding V}" />
  </StackPanel>
</UserControl>
