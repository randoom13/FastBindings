<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaBench"  x:Class="AvaloniaBench.CompiledDotted" x:DataType="vm:Vm">
  <StackPanel>
    <TextBlock Text="{Binding Child.A}" Width="{Binding Child.W}" IsVisible="{Binding Child.V}" />
  </StackPanel>
</UserControl>
