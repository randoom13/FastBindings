<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- builds on any machine (Windows' reference assemblies come from NuGet) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- FastBindings from this repository's FastBinding.Net5 project, with every change since 1.1.3 (FastBindings.WPF, which
         held no library, is no longer referenced). Once the next FastBindings.WPF_50 package is on nuget.org, use it
         instead: -p:FastBindingsWpfVersion=1.1.4, or set the property here. -->
    <ProjectReference Include="..\FastBinding.Net5\FastBinding.Net5.csproj" Condition="'$(FastBindingsWpfVersion)' == ''" />
    <PackageReference Include="FastBindings.WPF_50" Version="$(FastBindingsWpfVersion)" Condition="'$(FastBindingsWpfVersion)' != ''" />
  </ItemGroup>

</Project>
