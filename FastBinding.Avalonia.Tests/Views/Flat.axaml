<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:FastBindings" x:Class="FastBindings.Tests.Views.Flat">
  <StackPanel>
    <TextBlock x:Name="Text" Text="{f:CommonBinding A}" Width="{f:CommonBinding W}" IsVisible="{f:CommonBinding V}" />
  </StackPanel>
</UserControl>
