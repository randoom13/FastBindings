<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:FastBindings" x:Class="FastBindings.Tests.Views.SwapCombo">
  <ComboBox x:Name="Combo" ItemsSource="{f:CommonBinding Items}" SelectedItem="{f:CommonBinding Selected, Mode=TwoWay}" />
</UserControl>
