<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:FastBindings" x:Class="FastBindings.Tests.Views.AsyncTwoWayCombo">
  <ComboBox x:Name="Combo" ItemsSource="{f:CommonBinding Items}" SelectedIndex="{f:AsyncCommonBinding Index, Mode=TwoWay}" />
</UserControl>
