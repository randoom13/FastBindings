<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:FastBindings" x:Class="FastBindings.Tests.Views.Lists">
  <StackPanel>
    <ItemsControl x:Name="List" ItemsSource="{f:CommonBinding List}" />
    <Button x:Name="Button" Command="{f:CommonBinding Command}" />
  </StackPanel>
</UserControl>
