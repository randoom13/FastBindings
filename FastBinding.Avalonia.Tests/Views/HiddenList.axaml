<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:FastBindings" x:Class="FastBindings.Tests.Views.HiddenList">
  <StackPanel>
    <Border x:Name="Details" IsVisible="{f:CommonBinding ShowDetails}">
      <ItemsControl x:Name="List" ItemsSource="{f:CommonBinding List}" />
    </Border>
  </StackPanel>
</UserControl>
