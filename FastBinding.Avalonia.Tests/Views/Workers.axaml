<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:FastBindings" x:Class="FastBindings.Tests.Views.Workers">
  <!-- one binding of each kind whose value changes go through the general path: a change on a worker thread must not wait for the UI thread -->
  <StackPanel>
    <TextBlock x:Name="OneWay">
      <f:AttachedOneWayBindings.Collections>
        <f:OneWayBindingCollection>
          <f:OneWayCommonBinding Sources="A" Target="$[[this].Text]" />
        </f:OneWayBindingCollection>
      </f:AttachedOneWayBindings.Collections>
    </TextBlock>
    <TextBlock x:Name="AsyncOneWay">
      <f:AttachedOneWayBindings.Collections>
        <f:OneWayBindingCollection>
          <f:AsyncOneWayCommonBinding Sources="A" Target="$[[this].Text]" />
        </f:OneWayBindingCollection>
      </f:AttachedOneWayBindings.Collections>
    </TextBlock>
    <TextBlock x:Name="Async" Text="{f:AsyncCommonBinding A}" />
  </StackPanel>
</UserControl>
