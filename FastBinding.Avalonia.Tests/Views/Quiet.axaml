<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="using:FastBindings" x:Class="FastBindings.Tests.Views.Quiet">
  <!-- what is no problem with a binding: nothing is reported for any of these -->
  <StackPanel>
    <TextBlock x:Name="NullPath" Text="{f:CommonBinding Child.Name}" />
    <Border x:Name="NullBool" IsVisible="{f:CommonBinding Child.Shown}" Opacity="{f:CommonBinding Child.Shade}" />
    <!-- its child's binding meets the window's view-model before the panel's own DataContext arrives -->
    <StackPanel x:Name="Own" DataContext="{f:CommonBinding Other}">
      <TextBlock x:Name="FromOther" Text="{f:CommonBinding Name}" />
    </StackPanel>
  </StackPanel>
</UserControl>
