<Project Sdk="Microsoft.NET.Sdk">
  <!-- Classic {Binding} and FastBindings' CommonBinding on the same WPF views (Windows only): see README.md -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <RootNamespace>WpfBench</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FastBinding.Net5\FastBinding.Net5.csproj" />
  </ItemGroup>
</Project>
